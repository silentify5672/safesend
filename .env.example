# Copy this file to .env and fill in your own values.
# Format: NAME=value   (equals sign, no spaces, no quotes)

# PayPal sandbox keys: developer.paypal.com > Apps & Credentials > your app
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_secret

# AI check: fill in ONE of these. Leave both empty to use safety rules only.
# Gemini key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude key: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional
# CURRENCY=SGD   (or USD)
# GEMINI_MODEL=gemini-flash-latest
# ANTHROPIC_MODEL=claude-haiku-5-5
# FLASK_SECRET_KEY=any_long_random_text
